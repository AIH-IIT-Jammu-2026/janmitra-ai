# JanMitra AI Environment Configuration Template
# Duplicate this file to .env before starting backend & frontend

# Backend Environment Variables
GEMINI_API_KEY=your_gemini_api_key_here
PORT=8000
ENVIRONMENT=development

# Supabase Auth Configuration (Optional - Demo mode works automatically if unconfigured)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here
